<?xml version="1.0" encoding="utf-8"?>
<!--
    widget_lecture_row.xml
    A single lecture card row, inflated for each lecture.
    Matches the card style in the screenshot: dark navy bg, time on top-left,
    type badge top-right, subject name bold, room small below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lec_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_lecture_card"
    android:padding="10dp">

    <!-- Row 1: dot + time  |  type badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- Status dot -->
        <ImageView
            android:id="@+id/lec_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/shape_dot"
            android:layout_marginEnd="6dp" />

        <!-- Time range -->
        <TextView
            android:id="@+id/lec_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#AABBCC"
            android:textSize="11sp" />

        <!-- Type badge: "Lecture" / "Practical" / "Tutorial" -->
        <TextView
            android:id="@+id/lec_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_type_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Subject name -->
    <TextView
        android:id="@+id/lec_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="3dp" />

    <!-- Room / location row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/lec_room"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8899BB"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
